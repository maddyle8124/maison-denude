---
import type { FooterSection } from '../../content/types';
import Logo from '../ui/Logo.astro';
import SocialIcons from '../ui/SocialIcons.astro';

type Props = FooterSection;
const { id, taglineTitle, taglineBody, socials } = Astro.props;
---

<footer class="footer" id={id}>
  <div class="footer__inner">
    <div class="footer__logo">
      <Logo variant="white" width={240} />
    </div>
    <p class="footer__tagline-title">{taglineTitle}</p>
    <p class="footer__tagline-body">{taglineBody}</p>
    <SocialIcons items={socials} />
  </div>
  <div class="footer__bar">
    <span>© 2025 Maison Dénudé · 194 Lê Thánh Tôn, Q.1, TP.HCM · <a href="/booking">Booking</a></span>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg);
    padding-top: var(--gap-section);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 80px 32px;
  }
  .footer__logo {
    margin-bottom: 8px;
  }
  .footer__tagline-title {
    font-size: var(--text-footer-tagline);
    font-weight: var(--fw-extralight);
    color: var(--color-text);
    text-align: center;
  }
  .footer__tagline-body {
    font-size: var(--text-footer-body);
    font-weight: var(--fw-extralight);
    color: var(--color-text);
    text-align: center;
    max-width: 640px;
    line-height: 1.6;
  }
  .footer__bar {
    border-top: 1px solid var(--color-rule);
    padding: 16px 32px;
    font-size: var(--text-footer-bar);
    font-weight: var(--fw-extralight);
    color: var(--color-text);
    text-align: center;
  }
  .footer__bar a {
    color: var(--color-text);
    text-decoration: none;
  }
</style>
