---
import type { HeroSection } from '../../content/types';
import SmartImage from '../ui/SmartImage.astro';

type Props = HeroSection;
const { imageDesktop, imageMobile } = Astro.props;
---

<section class="hero" id="hero-section">
  <div class="hero__img hero__img--desktop">
    <SmartImage
      src={imageDesktop}
      alt=""
      loading="eager"
      fit="cover"
      widths={[800, 1200, 1920]}
      sizes="100vw"
    />
  </div>
  <div class="hero__img hero__img--mobile">
    <SmartImage
      src={imageMobile}
      alt=""
      loading="eager"
      fit="cover"
      widths={[400, 768]}
      sizes="100vw"
    />
  </div>

  <div class="hero__logo-wrap" id="hero-logo-inline">
    <img src="/logo_white.svg" class="hero__logo" alt="Maison Dénudé" />
  </div>
</section>

<div class="hero__logo-fixed" id="hero-logo-fixed" aria-hidden="true">
  <img src="/logo_white.svg" class="hero__logo-fixed-img" alt="" />
</div>

<script>
  const heroSection = document.getElementById('hero-section');
  const inHeroLogo  = document.getElementById('hero-logo-inline');
  const fixedLogo   = document.getElementById('hero-logo-fixed');

  if (heroSection && inHeroLogo && fixedLogo) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          fixedLogo.style.opacity = '1';
          inHeroLogo.style.opacity = '0';
        } else {
          fixedLogo.style.opacity = '0';
          inHeroLogo.style.opacity = '1';
        }
      },
      { threshold: 0 }
    );
    observer.observe(heroSection);
  }
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* Both wrappers sit full-bleed, stacked; only one is visible per breakpoint */
  .hero__img {
    position: absolute;
    inset: 0;
  }

  /* The SmartImage <img> inside must fill its wrapper div */
  .hero__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Desktop image: visible on ≥768px */
  .hero__img--desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .hero__img--desktop {
      display: block;
    }
    .hero__img--mobile {
      display: none;
    }
  }

  /* Logo wrapper — centered in hero */
  .hero__logo-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  /* Mobile: logo at vertical center, right edge */
  @media (max-width: 767px) {
    .hero__logo-wrap {
      justify-content: flex-end;
      padding-right: 24px;
    }
  }

  .hero__logo {
    width: 1176px;
    height: auto;
    display: block;
  }

  @media (max-width: 767px) {
    .hero__logo {
      width: 240px;
    }
  }

  /* Fixed logo — lives outside hero, always in bottom-right corner */
  .hero__logo-fixed {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
    pointer-events: none;
    mix-blend-mode: difference;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hero__logo-fixed-img {
    width: 360px;
    height: auto;
    display: block;
  }

  @media (max-width: 767px) {
    .hero__logo-fixed-img {
      width: 60px;
    }
  }
</style>
