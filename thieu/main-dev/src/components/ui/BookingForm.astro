---
import { actions } from 'astro:actions';

// Reusable booking form (used on /booking now, persistent modal later).
// Progressive enhancement: posts to the createBooking action and works without JS.
const result = Astro.getActionResult(actions.createBooking);
const success = result && !result.error;
const failed = result && result.error;
---

{success ? (
  <p class="booking__success">We'll reach out within 24h.</p>
) : (
  <form method="POST" action={actions.createBooking} class="booking">
    {failed && (
      <p class="booking__error">
        Something went wrong. Please check your details and try again.
      </p>
    )}

    <div class="booking__field">
      <label class="booking__label" for="name">Name</label>
      <input class="booking__input" type="text" id="name" name="name" required />
    </div>

    <div class="booking__field">
      <label class="booking__label" for="phone">Phone / Zalo / WhatsApp</label>
      <input class="booking__input" type="tel" id="phone" name="phone" required minlength="6" />
    </div>

    <div class="booking__field">
      <label class="booking__label" for="date">Preferred date</label>
      <input class="booking__input" type="date" id="date" name="date" required />
    </div>

    <div class="booking__field">
      <label class="booking__label" for="consultationType">Consultation type</label>
      <select class="booking__input booking__select" id="consultationType" name="consultationType" required>
        <option value="atelier">Atelier visit</option>
        <option value="virtual">Virtual consultation</option>
        <option value="event">Event / occasion</option>
      </select>
    </div>

    <div class="booking__field">
      <label class="booking__label" for="notes">Message</label>
      <textarea class="booking__input booking__textarea" id="notes" name="notes" rows="4"></textarea>
    </div>

    <button class="booking__submit" type="submit">Request consultation</button>
  </form>
)}

<style>
  .booking {
    display: flex;
    flex-direction: column;
    gap: var(--form-field-gap);
    max-width: var(--form-max-width);
    width: 100%;
  }
  .booking__field {
    display: flex;
    flex-direction: column;
    gap: var(--form-label-gap);
  }
  .booking__label {
    font-family: var(--font-primary);
    font-size: var(--text-label);
    font-weight: var(--fw-extralight);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--color-text);
  }
  .booking__input {
    font-family: var(--font-primary);
    font-size: var(--text-field);
    font-weight: var(--fw-extralight);
    color: var(--color-text);
    background: var(--color-bg);
    border: none;
    border-bottom: var(--field-border);
    padding: var(--field-padding-y) 0;
    width: 100%;
    border-radius: 0;
  }
  .booking__input:focus {
    outline: none;
    border-bottom: var(--field-border-focus);
  }
  .booking__select {
    appearance: none;
    cursor: pointer;
  }
  .booking__select option {
    background: var(--color-bg);
    color: var(--color-text);
  }
  .booking__textarea {
    resize: vertical;
    border: var(--field-border);
    padding: var(--field-padding-y);
  }
  .booking__textarea:focus {
    border: var(--field-border-focus);
  }
  .booking__submit {
    font-family: var(--font-primary);
    font-size: var(--text-label);
    font-weight: var(--fw-extralight);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--color-text);
    background: transparent;
    border: var(--field-border);
    padding: var(--field-padding-y) var(--gap-section);
    cursor: pointer;
    align-self: flex-start;
    transition: opacity 0.2s;
  }
  .booking__submit:hover {
    opacity: 0.6;
  }
  .booking__success {
    font-family: var(--font-primary);
    font-size: var(--text-footer-tagline);
    font-weight: var(--fw-extralight);
    color: var(--color-text);
  }
  .booking__error {
    font-family: var(--font-primary);
    font-size: var(--text-field);
    font-weight: var(--fw-extralight);
    color: var(--color-text);
    opacity: 0.7;
  }
  /* Normalize the native date picker indicator on dark bg */
  .booking__input::-webkit-calendar-picker-indicator {
    filter: invert(1);
    opacity: 0.6;
    cursor: pointer;
  }
</style>
