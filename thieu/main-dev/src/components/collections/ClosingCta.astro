---
/* Single centered line linking to booking — thin rule above, house style. */
interface Props {
  label: string;
  href: string;
}
const { label, href } = Astro.props;
---

<section class="closing-cta">
  <span class="closing-cta__rule" aria-hidden="true"></span>
  <a class="closing-cta__link" href={href}>{label}</a>
</section>

<style>
  .closing-cta {
    background: var(--color-bg);
    padding: var(--gap-section) var(--label-left) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--label-bottom);
  }
  .closing-cta__rule {
    width: var(--collection-rule-width);
    border-top: 1px solid var(--color-rule);
  }
  .closing-cta__link {
    font-family: var(--font-primary);
    font-size: var(--text-nav);
    font-weight: var(--fw-extralight);
    text-transform: uppercase;
    letter-spacing: var(--ls-nav);
    color: var(--color-text);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .closing-cta__link:hover {
    opacity: 0.6;
  }
</style>
