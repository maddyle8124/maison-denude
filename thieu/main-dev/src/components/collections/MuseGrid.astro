---
import SmartImage from '../ui/SmartImage.astro';
import SectionLabel from './SectionLabel.astro';
import type { CollectionImage } from '../../content/collections';

/*
 * Asymmetric editorial rhythm — rows alternate 2-up / 3-up / solo (repeating),
 * deliberately NOT a uniform 3xN grid. Small name caption under each card.
 */
interface Props {
  label: string;
  items: CollectionImage[];
}
const { label, items } = Astro.props;

const rhythm = [2, 3, 1];
const rows: CollectionImage[][] = [];
for (let i = 0, step = 0; i < items.length; step++) {
  rows.push(items.slice(i, i + rhythm[step % rhythm.length]));
  i += rhythm[step % rhythm.length];
}
---

<section class="muses">
  <SectionLabel label={label} />
  <div class="muses__rows">
    {rows.map((row) => (
      <div class:list={['muses__row', `muses__row--${row.length}`]}>
        {row.map((item) => (
          <figure class="muses__card">
            <SmartImage
              src={item.imageKey}
              alt={item.alt}
              fit="contain"
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
            {item.caption && <figcaption class="muses__caption">{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .muses {
    background: var(--color-bg);
    padding: var(--gap-section) var(--label-left) 0;
  }
  .muses__rows {
    display: flex;
    flex-direction: column;
    gap: var(--gap-section);
  }
  .muses__row {
    display: grid;
    gap: var(--gap-image);
    align-items: start;
  }
  .muses__row--2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .muses__row--3 {
    grid-template-columns: repeat(3, 1fr);
  }
  /* Solo row: a narrower centered card breaks the grid cadence. */
  .muses__row--1 {
    grid-template-columns: 1fr;
    max-width: var(--collection-hero-max);
    margin: 0 auto;
    width: 100%;
  }
  .muses__card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-image);
  }
  .muses__caption {
    font-size: var(--text-collection-sub);
    font-weight: var(--fw-extralight);
    text-transform: uppercase;
    letter-spacing: var(--ls-collection-sub);
    color: var(--color-text);
    text-align: center;
  }
  @media (max-width: 767px) {
    .muses__row--2,
    .muses__row--3 {
      grid-template-columns: 1fr;
    }
    .muses__row {
      gap: var(--gap-section);
    }
  }
</style>
