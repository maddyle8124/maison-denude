{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-24",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "maisondenude-web",
	// D-BOOK-INFRA-01: the worker + domain live in the thieuxmaison account.
	// The previous id (ecb2e6bb… = nguyenthaithieu) was an error.
	"account_id": "73fb68b2979b1b17abbafc4eccdbc354",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"PUBLIC_GTM_ID": "GTM-PKQ647S4"
	}
}